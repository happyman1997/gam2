#![enable(implicit_some)]
// Развитие лидера: после босса (кроме последнего) — выбор одного из двух, навсегда. Ключ верхнего уровня — лидер из
// units.ron; key — ключ слов в игре (growth.<key>); leader — что получает сам лидер (как give в finds.ron, и ещё
// better — способности, которые заменяют такую же у него); army — что получает каждый в армии, кроме лидера;
// cells — ещё ячеек каждому голему армии, own_cells — только лидеру; units — тела в армию (ключи units.ron).
// По концепту (CONCEPT.md, «Развитие: …»): не прибавки к числам, а повадки («Повадки вместо цифр»); числа временные.
{
    // +1 ячейка или колоссальный модуль (колоссальных модулей в симуляции пока нет); бросок чаще и дальше
    "otets_kolossa": [
        (key: "colossus_cell", own_cells: 1),
        (key: "colossus_hurl", leader: (better: [Hurl(every: 2, range: 8)])),
        (key: "colossus_quake", leader: (traits: [Shockwave])),
        (key: "colossus_hull", leader: (traits: [ShedPlates])),
    ],
    // новый вид аугментов или +1 аугмент на голема
    "izobretatel": [
        (key: "inventor_cells", cells: 1),
        (key: "inventor_coil", leader: (module: "grozovaya_katushka")),
        (key: "inventor_shocker", leader: (dmg: Shock, traits: [Chain])),
    ],
    // новый безумный модуль или причуды чаще полезны
    "manyak": [
        (key: "maniac_tinker", leader: (better: [Tinker(every: 2)])),
        (key: "maniac_cells", cells: 1),
        (key: "maniac_saw", leader: (dmg: Slash, traits: [Whirl])),
    ],
    // каменщик, чертёж шире, стены крепче (броня армии), кирпичи
    "zodchiy": [
        (key: "builder_mason", units: ["kamenshchik"]),
        (key: "builder_plan", leader: (better: [Blueprint(n: 14)])),
        (key: "builder_walls", leader: (traits: [Rubble])),
        (key: "builder_bricks", leader: (traits: [Lob])),
    ],
    // кладка чаще, +1 личинка или крупнее
    "matka": [
        (key: "matka_often", leader: (better: [Brood(every: 2, n: 2)])),
        (key: "matka_more", leader: (traits: [Ambush])),
        (key: "matka_big", leader: (traits: [Escort])),
    ],
    // пси-удара, Захвата и Помутнения в симуляции пока нет: метка чаще, подмена чаще, воля роя, панцирь
    "razum": [
        (key: "mind_mark", leader: (better: [Mark(every: 1)])),
        (key: "mind_swap", leader: (better: [Swap(every: 2)])),
        (key: "mind_will", leader: (traits: [Rally])),
        (key: "mind_shell", leader: (traits: [MindWard])),
    ],
    // крупнее, глотает чаще, челюсти, шкура
    "pozhiratel": [
        (key: "devourer_bigger", leader: (traits: [Belch])),
        (key: "devourer_belly", leader: (better: [Swallow(every: 2)])),
        (key: "devourer_jaws", leader: (traits: [Crush])),
        (key: "devourer_hide", leader: (traits: [AcidBlood])),
    ],
    // заражает и яд скорпионов; чумная кровь стае; панцирь
    "kukushka": [
        (key: "plague_venom", leader: (traits: [Venom(die: 6)])),
        (key: "plague_blood", leader: (traits: [PlagueBlood])),
        (key: "plague_shell", leader: (traits: [Cocoon])),
    ],
}

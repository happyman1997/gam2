#![enable(implicit_some)]
// Правила похода, которые держат философию классов (docs/CONCEPT.md, docs/BALANCE.md «Баланс классов»).
// Литейщик — мало, но сильные: число големов держит лидерство. Рой — толпа: предел роя в очках, выводок
// переполняет его, лишних съедают (съеденное — биомасса).
(
    // ---- Литейщик: лидерство
    // на старте у каждого лидера (Отцу колосса — на одного Механика, Изобретателю — с запасом на малый фрейм);
    // растёт за каждый выигранный бой и ещё за босса; lead_fixed — у кого не растёт
    lead_start: {"otets_kolossa": 3, "izobretatel": 14, "manyak": 14, "zodchiy": 10},
    lead_fixed: [],
    lead_fight: 1,
    lead_boss: 3,
    // цена голема в лидерстве; малый фрейм (на размер меньше) — на 1 дешевле; лидеры и каменщики (призыв) — даром
    lead_cost: {"strazh": 7, "mudrets": 5, "gorn": 5, "orudie": 5, "mekhanik": 3},

    // ---- Рой: предел роя в очках
    // особь стоит очков по размеру: рабочая (1) — 1, солдат (2) — 3, гигант солдата (3) — 6; лидер — даром
    // у каждого лидера свой: стартовая армия — 100 очков, остальное дозаполнит выводок после первой победы (у
    // Матки сильнее кладка и мутации, у Пожирателя лидер идёт впереди и гибнет первым — ему рой побольше)
    limit_start: {"matka": 100, "razum": 110, "pozhiratel": 120, "kukushka": 110},
    limit_fight: 6,
    limit_boss: 20,
    // выводок после победы: вылупляется всё — павшие снова, своей породой, и кладки рабочих сверх предела на
    // clutch очков; лишнее съедают, каждые eaten_per_biomass съеденных очков — единица биомассы
    clutch: 10,
    // у каждой породы (формы) гнёзда для найденных мутаций, как ячейки у голема: мутация всей породы — сильная
    // вещь, и без предела основная масса роя набирала их десяток (эволюции за биомассу — сверх гнёзд)
    nests: 2,
    eaten_per_biomass: 2,
)
